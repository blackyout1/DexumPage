# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ========================================================
# ПЛАТЕЖНЫЕ ШЛЮЗЫ (ОПЛАТА КАРТАМИ, СБП, КРИПТОЙ)
# ========================================================

# 1. AAIO (https://aaio.so) — СБП, Карты РФ/МИР, Крипта, P2P
AAIO_API_KEY=""
AAIO_SHOP_ID=""
AAIO_SECRET_1=""
AAIO_SECRET_2=""

# 2. FREEKASSA (https://freekassa.ru)
FREEKASSA_MERCHANT_ID=""
FREEKASSA_SECRET_1=""
FREEKASSA_SECRET_2=""

# 3. CRYSTALPAY (https://crystalpay.io)
CRYSTALPAY_AUTH_LOGIN=""
CRYSTALPAY_AUTH_SECRET=""

# 4. LAVA (https://lava.top)
LAVA_SHOP_ID=""
LAVA_SECRET_KEY=""
